{
  "name": "@local/dsh-archive-viewer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Control archived-session visibility and enable DSH's official full-text session search.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surkaa/dsh-archive-viewer.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}